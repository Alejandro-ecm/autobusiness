# ══════════════════════════════════════════════════════════════
# AutoBusiness AI — Variables de entorno
# Copiar este archivo a .env y completar los valores reales
# NUNCA subir .env a Git
# ══════════════════════════════════════════════════════════════

# ── Base de datos ─────────────────────────────────────────────
# Local (docker-compose lo maneja automáticamente)
# En Railway: usar los valores del plugin Postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/autobusiness
SPRING_DATASOURCE_USERNAME=autobusiness
SPRING_DATASOURCE_PASSWORD=autobusiness_secret

# ── JWT ───────────────────────────────────────────────────────
# Generar con: openssl rand -hex 64
JWT_SECRET=CAMBIAR_POR_SECRETO_SEGURO_EN_PRODUCCION

# ── Mercado Pago ──────────────────────────────────────────────
# Obtener en: https://www.mercadopago.com.mx/developers/panel/credentials
MP_ACCESS_TOKEN=TEST-XXXXXXXXXX-XXXXXXXX-XXXXXXXXXXXXXXXXXX
MP_NOTIFICATION_URL=https://TU_APP.up.railway.app/api/payments/mercadopago/webhook
MP_SUCCESS_URL=https://TU_APP.up.railway.app/payment/success
MP_FAILURE_URL=https://TU_APP.up.railway.app/payment/failure
MP_PENDING_URL=https://TU_APP.up.railway.app/payment/pending

# ── App URLs ──────────────────────────────────────────────────
APP_BASE_URL=https://TU_APP.up.railway.app
APP_BASE_DOMAIN=up.railway.app

# ── Frontend ──────────────────────────────────────────────────
# Solo para desarrollo local con SSL en celular
HOST_IP=192.168.1.5

# ── Railway (frontend service) ────────────────────────────────
# URL interna del backend en Railway (private networking)
BACKEND_URL=http://autobusiness-backend.railway.internal:8080
RAILWAY_ENVIRONMENT=production
